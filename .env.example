# Model (open-weight only). Any OpenAI-compatible endpoint works.
LLM_PROVIDER=openrouter            # openrouter | ollama | vllm
LLM_MODEL=                         # set after choosing, e.g. an open-weight model id
LLM_BASE_URL=                      # empty = default for the provider
LLM_API_KEY=                       # OpenRouter key; never commit the real .env

# MCP server
MCP_URL=http://127.0.0.1:8001/mcp

# Context policy (Phase 3)
MAX_TOOL_CHARS=4000
MAX_WINDOW=8
SUMMARY_TRIGGER=12
MAX_STEPS=6
