# ---- Model (open-weight): Gemma through Ollama, a cloud-hosted model ----
# Needs Ollama installed and `ollama signin` done once. No API key.
LLM_PROVIDER=ollama
LLM_MODEL=gemma4:31b-cloud
LLM_BASE_URL=
LLM_API_KEY=

# ---- MCP server ----
MCP_URL=http://127.0.0.1:8001/mcp

# ---- Context policy ----
# max chars of a stored tool message, messages sent to the model,
# stored messages that trigger summarization, max chars of the summary, tool loop limit
MAX_TOOL_CHARS=6000
MAX_WINDOW=8
SUMMARY_TRIGGER=12
SUMMARY_MAX_CHARS=1200
MAX_STEPS=6

# ---- Where the JSONL trace of each session is written ----
TRACE_DIR=traces
